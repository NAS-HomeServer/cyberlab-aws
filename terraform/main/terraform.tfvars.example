# Copier en terraform.tfvars (ignore par git) et adapter. Aucun secret ici.

# Cle publique SSH utilisee par Ansible (le contenu de ~/.ssh/id_ed25519.pub).
ssh_public_key = "ssh-ed25519 AAAA... utilisateur@poste"

# Votre IP publique en /32 pour ouvrir SSH ; liste vide = aucun port entrant
# (acces par AWS Systems Manager uniquement).
ssh_allowed_cidrs = ["203.0.113.10/32"]

# Destinataire des alertes de budget.
budget_email = "vous@example.com"

# instance_type = "t3.small"   # passer a t3.medium si le noeud manque de memoire
# monthly_budget_usd = 15
